<configure
    xmlns="http://namespaces.zope.org/zope">

  <adapter
      factory=".adapters.PublicationTimeStamper"
      provides="collective.timestamp.adapters.ITimeStamper"
      for="plonemeeting.portal.core.content.publication.IPublication"
      />

  <adapter
      factory=".adapters.AssistantAdapter"
      provides="imio.omnia.assistant.interfaces.IOmniaAssistantAdapter"
      for="*
           zope.publisher.interfaces.browser.IBrowserRequest"
      />

  <adapter
      factory=".adapters.OrganizationIDProvider"
      provides="imio.omnia.core.interfaces.IOrganizationIDProvider"
      for="*"
      />

  <adapter
      factory=".adapters.LatestItemsFolderFeed"
      provides="plone.base.interfaces.syndication.IFeed"
      for="plonemeeting.portal.core.interfaces.IMeetingsFolder"
      />

  <adapter
      factory=".adapters.LatestItemsFolderFeed"
      provides="plone.base.interfaces.syndication.IFeed"
      for="plonemeeting.portal.core.interfaces.IPublicationsFolder"
      />

  <adapter
      factory=".locking.MeetingsFolderLockSettings"
      provides="plone.locking.interfaces.ILockSettings"
      for="plonemeeting.portal.core.interfaces.IMeetingsFolder"
      />

</configure>
