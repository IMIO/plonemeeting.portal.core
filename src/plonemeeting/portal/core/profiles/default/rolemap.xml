<?xml version="1.0"?>
<rolemap>

  <permissions>
    <permission name="plonemeeting.portal.core: Add Item" acquire="True">
      <role name="Manager"/>
    </permission>

    <permission name="plonemeeting.portal.core: Add Meeting" acquire="True">
      <role name="Manager"/>
    </permission>

    <permission name="plonemeeting.portal.core: Add Institution" acquire="True">
      <role name="Manager"/>
    </permission>

    <permission name="plonemeeting.portal.core: Add Publication" acquire="True">
      <role name="Contributor"/>
      <role name="Manager"/>
    </permission>

    <permission name="eea.facetednavigation: Configure faceted" acquire="True">
      <role name="Manager"/>
    </permission>

    <permission name="plone.app.contenttypes: Add Folder" acquire="False">
      <role name="Manager"/>
    </permission>

    <permission name="plone.restapi: Use REST API" acquire="True">
      <!-- was given to "Anonymous" by default by plone.restapi -->
      <role name="Member"/>
    </permission>

    <permission name="Modify view template" acquire="False">
      <!-- do not let editors change view template -->
      <role name="Manager"/>
    </permission>

    <permission name="Access inactive portal content" acquire="False">
      <!-- give access to expired content to Member because checked by Plone
           at the portal_catalog level, the View permission will hide not
           viewable elements nevertheless -->
      <role name="Member"/>
      <role name="Manager"/>
      <role name="Site Administrator"/>
    </permission>

    <permission name="imio.omnia.core: Access Omnia OpenAI proxy" acquire="False">
      <!-- Allow Anonymous so the assistant widget works on public publication pages.
           The AssistantAdapter.is_available() check is the real security gate. -->
      <role name="Anonymous"/>
      <role name="Member"/>
      <role name="Manager"/>
    </permission>

    <permission name="View History" acquire="True">
      <!-- DELIBE-287: let users with the Reader local role (publications
           managers/creators/reviewers, decisions managers, etc.) see the
           workflow/version history of institution content in every workflow
           state. Flows down to all workflowed content via acquisition since
           no workflow declares View History in its <permission> header. -->
      <role name="Reader"/>
      <role name="Contributor"/>
      <role name="Reviewer"/>
      <role name="Editor"/>
      <role name="Manager"/>
      <role name="Site Administrator"/>
    </permission>

  </permissions>

</rolemap>
